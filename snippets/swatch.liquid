{% comment %}
  Renders a swatch component.
  Accepts:
  - swatch: {Object} a swatch object
  - shape: {String} swatch shape. Accepts 'square', defaults to circle.

  Usage:
  {% render 'swatch',
    swatch: value.swatch
    shape: 'square'
  %}
{% endcomment %}

{%- liquid
  assign final_swatch_value = null

  if swatch_value != blank
    assign final_swatch_value = swatch_value
  elsif swatch.image
    assign image_url = swatch.image | image_url: width: 50
    assign final_swatch_value = 'url(' | append: image_url | append: ')'
    assign swatch_focal_point = swatch.image.presentation.focal_point
  elsif swatch.color
    assign final_swatch_value = 'rgb(' | append: swatch.color.rgb | append: ')'
  endif
-%}

<span
  {% if final_swatch_value %}
    class="swatch{% if shape == 'square' %} swatch--square{% endif %}"
    style="
      --swatch--background: {{ final_swatch_value }};
      {% if swatch_focal_point %}
        --swatch-focal-point: {{ swatch_focal_point }};
      {% endif %}
    "
  {% else %}
    class="swatch swatch--unavailable{% if shape == 'square' %} swatch--square{% endif %}"
  {% endif %}
></span>
