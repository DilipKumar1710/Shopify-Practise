        "faq_BPqtdz": {
          "type": "faq",
          "settings": {
            "parent_category": "shipping-and-delivery",
            "question": "How long does it take to receive an order?",
            "answer": "<p>Our products are handcrafted and made-to-order. Typically, it takes<strong>4-5 days to craft</strong>an item, followed by an additional<strong>3-4 days for delivery.</strong>Please allow<strong>7 to 10 days</strong>in total to receive your order.</p>"
          }
        },
        "faq_xGMGnc": {
          "type": "faq",
          "settings": {
            "parent_category": "shipping-and-delivery",
            "question": "How can I track my order?",
            "answer": "<p>Once your order is shipped, you will receive tracking information via <strong>email, SMS, and WhatsApp.</strong>You can use the provided tracking number to monitor the status and estimated delivery date of your order. Link to -&gt;<a href=\"https://banjaaranstudio.ithinklogistics.co.in/\" target=\"_blank\">Order Tracking Page</a></p>"
          }
        },
        "faq_9jQGGP": {
          "type": "faq",
          "settings": {
            "parent_category": "shipping-and-delivery",
            "question": "What are the shipping rates for orders within India?",
            "answer": "<p><strong>We offer free shipping across India for all prepaid orders.</strong>For Cash on Delivery (COD) orders, a charge of ₹199 is added.</p>"
          }
        },
        "faq_pMHNTG": {
          "type": "faq",
          "settings": {
            "parent_category": "shipping-and-delivery",
            "question": "How long does it take to receive an order?",
            "answer": "<p>Our products are handcrafted and made-to-order. Typically, it takes<strong>4-5 days to craft</strong>an item, followed by an additional<strong>3-4 days for delivery.</strong>Please allow<strong>7 to 10 days</strong>in total to receive your order.</p>"
          }
        },
        "faq_CtAXnM": {
          "type": "faq",
          "settings": {
            "parent_category": "shipping-and-delivery",
            "question": "Which courier partners do you use for delivery?",
            "answer": "<p>We use multiple reputed courier partners like<strong>Bluedart, Delhivery, FedEx, and Aramex,</strong>employing their Air Express services to ensure timely delivery without additional charges.</p>"
          }
        },
        "faq_GcRWaU": {
          "type": "faq",
          "settings": {
            "parent_category": "exchange-and-returns",
            "question": "How do I start the exchange process and is there a time limit to request an exchange?",
            "answer": "<p>To start an exchange at Banjaaran Studio, submit your request through our<a href=\"https://banjaaran.in/apps/return_prime\" target=\"_blank\">Exchange Request Portal</a>within 7 days of delivery. We cover all shipping costs for exchanges, ensuring a hassle-free process for you.</p>"
          }
        },
        "faq_X7ypni": {
          "type": "faq",
          "settings": {
            "parent_category": "exchange-and-returns",
            "question": "Can I exchange my item for a different product or style?",
            "answer": "<p>Exchanges are <strong>strictly limited to size changes only</strong>. We do<strong>not allow exchanges</strong>for different products or styles. If you need a different product or style, please<strong>place a new order</strong>for the desired item or contact support for a resolution.</p>"
          }
        },
        "faq_fXGcid": {
          "type": "faq",
          "settings": {
            "parent_category": "exchange-and-returns",
            "question": "What conditions must the item meet for an exchange or return to be eligible?",
            "answer": "<p>The item must be in immaculate, resellable condition with no signs of wear, and must retain all original packaging, tags, accessories, and gifts.</p>"
          }
        },
        "faq_tPwcWU": {
          "type": "faq",
          "settings": {
            "parent_category": "exchange-and-returns",
            "question": "What happens if the exchanged item doesn't fit or meet my expectations again?",
            "answer": "<p>Once a size exchange is processed, no further exchanges or returns will be permitted, making the sale final. Please contact support for furthur assistence.</p>"
          }
        },
        "faq_qt8aGM": {
          "type": "faq",
          "settings": {
            "parent_category": "exchange-and-returns",
            "question": "How long does the entire exchange or return process take?",
            "answer": "<p>The entire process for <strong>exchanges </strong>can take <strong>11-18 days</strong>, and for<strong>returns</strong>, it can take <strong>6-12 days</strong>, depending on logistics, inspection, and production times.</p>"
          }
        },
        "faq_PqxwNg": {
          "type": "faq",
          "settings": {
            "parent_category": "miscellaneous",
            "question": "Where are we based and do you have any physical stores?",
            "answer": "<p>We are based in<strong>Faridabad, Delhi NCR</strong>, where we manage our in-house manufacturing. Currently,<strong>we exclusively sell our products online</strong>and do not operate any physical retail outlets. We<strong>ship PAN India.</strong>Please enjoy browsing our comprehensive online collection, and if you have any queries or need assistance, feel free to reach out.</p>"
          }
        },
        "faq_LYgg8C": {
          "type": "faq",
          "settings": {
            "parent_category": "miscellaneous",
            "question": "Do you offer product customizations?",
            "answer": "<p>At this time,<strong>we do not offer customizations.</strong>Please explore our existing product range to find items that meet your needs.</p>"
          }
        },
        "faq_GzDJnW": {
          "type": "faq",
          "settings": {
            "parent_category": "miscellaneous",
            "question": "When is a token amount required for COD orders?",
            "answer": "<p>A token amount of<strong>INR 500</strong>is required for COD orders if you've previously not accepted a COD order, your address is incomplete, or the delivery is to a distant region. This ensures the dedication of our artisans is respected. You'll receive a payment link via email for secure payment.</p>"
          }
        },
        "faq_LztC9y": {
          "type": "faq",
          "settings": {
            "parent_category": "miscellaneous",
            "question": "What is the tax component in the products you sell?",
            "answer": "<p>The price of our products includes<strong>18% GST</strong>, ensuring transparency in your purchase.</p>"
          }
        },
        "faq_PKyfc9": {
          "type": "faq",
          "settings": {
            "parent_category": "international-orders",
            "question": "What are the shipping costs and delivery timeline for international orders?",
            "answer": "<p><strong>International shipping costs are paid by the customer</strong>and are not included in the free shipping offer. We aim to ship your order within <strong>10-14 days</strong>, but delivery times may vary based on location, distance, and logistics partners.</p>"
          }
        },
        "faq_8CRHqf": {
          "type": "faq",
          "settings": {
            "parent_category": "international-orders",
            "question": "How can I place my international order and what are the payment options?",
            "answer": "<p>If you are facing any issues placing an international order, please contact support. For all international orders, payment must be prepaid using <strong>PayPal</strong>or<strong>Razorpay</strong>;<strong>Cash on Delivery (COD) is not available </strong>for these transactions.</p>"
          }
        },
        "faq_CiHVD7": {
          "type": "faq",
          "settings": {
            "parent_category": "international-orders",
            "question": "Are there additional fees I should be aware of when ordering internationally?",
            "answer": "<p>Yes, the recipient may be responsible for handling fees and taxes applicable in your country. For orders to the<strong>UK and EU</strong>, Customs and VAT will be charged as per local laws, which are payable by the customer.</p>"
          }
        },
        "faq_Mz894M": {
          "type": "faq",
          "settings": {
            "parent_category": "international-orders",
            "question": "What should I do if I receive a damaged item or if there are issues with my international order?",
            "answer": "<p>If your order arrives damaged or differs from what was ordered, please contact us immediately at <a>test@gmail.in </a>or via WhatsApp at<a href=\"https://wa.me/919999474819\" target=\"_blank\">+91-9876543210 </a>for assistance.</p>"
          }
        },
        "faq_J78miQ": {
          "type": "faq",
          "settings": {
            "parent_category": "international-orders",
            "question": "What is the policy for exchanges and returns on international orders?",
            "answer": "<p>We do not offer exchanges or returns on international orders. Please review your order carefully before finalizing to ensure it meets your needs.</p>"
          }
        },
        "faq_RYcHXE": {
          "type": "faq",
          "settings": {
            "parent_category": "contact-information",
            "question": "How can i contact customer support?",
            "answer": "<p>Our support is available via call, WhatsApp, and email at the provided contact details.<br/><br/>Call (11am to 6pm):<a href=\"tel:+919999474819\" target=\"_blank\">+91-9876543210 </a>WhatsApp:<a href=\"https://wa.me/919999474819\" target=\"_blank\">+919876543212</a><br/>Email:<a href=\"mailto:support@banjaaran.in\" target=\"_blank\">test@gmail.in</a>/<a href=\"mailto:studio@banjaaran.in\" target=\"_blank\">test@gmail.in</a></p>"
          }
        },
        "faq_33C4Yz": {
          "type": "faq",
          "settings": {
            "parent_category": "contact-information",
            "question": "How can I contact you for business-related queries, like collaborations, business proposals, or bulk order inquiries?",
            "answer": "<p>For business-related inquiries, please send an email to<br/><a href=\"mailto:karanveer@banjaaran.in\" target=\"_blank\">Dilip@test.in </a>and <a href=\"mailto:meera@banjaaran.in\" target=\"_blank\">Kumar@Test.in</a>. <br/>Be sure to clearly mention the<strong>purpose of your inquiry in the subject line</strong>to ensure a timely response. We look forward to exploring potential opportunities with you.</p>"
          }
        },
        "faq_CzAc6U": {
          "type": "faq",
          "settings": {
            "parent_category": "contact-information",
            "question": "How can I apply for a work opportunity at Banjaaran Studio?",
            "answer": "<p>Please fill out the application form available at the following link (<a href=\"https://forms.gle/WjH8MhVfQ3TbWDf46\" target=\"_blank\">Careers form link</a>) to apply for work opportunities at Banjaaran Studio. We look forward to considering your application.</p>"
          }
        },
        "faq_KdFyef": {
          "type": "faq",
          "settings": {
            "parent_category": "contact-information",
            "question": "How can I submit a complaint or report an issue?",
            "answer": "<p>If you encounter any issues with our products or services, please send an email to <a href=\"mailto:karanveer@banjaaran.in\" target=\"_blank\">Test@test.in</a>. Ensure you include your order number in the subject line for us to address your concerns promptly and effectively.</p>"
          }
        }
      },
